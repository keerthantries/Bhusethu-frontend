PORT=5000

# MongoDB Atlas
MONGO_URI=

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Admin login (stored in MongoDB). Create/update with:
# npm run seed-admin -- admin@bhusethu.com "your password"
#
# Optional first-run bootstrap: if set and the email does not exist yet, the
# account is created from these values on startup. Remove them after seeding.
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=
JWT_SECRET=change-this-long-random-string

# CORS + cookies
FRONTEND_URL=http://localhost:5173
NODE_ENV=development

# Cloudflare Turnstile (optional in local dev, required in production)
TURNSTILE_SECRET_KEY=
